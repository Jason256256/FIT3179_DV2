{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 240,
  "height": 220,
  "data": {
    "url": "data/section1_idiom2.csv"
  },
  "layer": [
    {
      "transform": [
        {"pivot": "gender", "value": "enrolment_rate", "groupby": ["year"]}
      ],
      "mark": "area",
      "encoding": {
        "x": {"field": "year", "type": "quantitative", "axis": {"format": "d"}, "title": "Year"},
        "y": {"field": "Female", "type": "quantitative", "scale": {"domain": [50, 100]}, "title": "Enrolment Rate (%)"},
        "y2": {"field": "Male"},
        "color": {"value": "#e0b0ff"},
        "opacity": {"value": 0.4}
      }
    },
    {
      "mark": {"type": "line", "point": true},
      "encoding": {
        "x": {"field": "year", "type": "quantitative"},
        "y": {"field": "enrolment_rate", "type": "quantitative", "scale": {"domain": [50, 100]}},
        "color": {
          "field": "gender",
          "type": "nominal",
          "scale": {"domain": ["Female", "Male"], "range": ["#ff00bf", "#00bfff"]},
          "legend": {
            "title": "Gender",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year"},
          {"field": "gender", "type": "nominal", "title": "Gender"},
          {"field": "enrolment_rate", "type": "quantitative", "title": "Rate (%)"}
        ]
      }
    },
    {
      "data": {"values": [{}]},
      "mark": {
        "type": "rect",
        "x": 8,
        "y": 135,
        "x2": 163,
        "y2": 177,
        "fill": "#ffffff",
        "stroke": "#b0c4de",
        "strokeWidth": 1,
        "cornerRadius": 4,
        "opacity": 0.92
      }
    },
    {
      "data": {
        "values": [
          {
            "annotation": "Enrolment rates in females are\nconsistently, albeit slightly higher\nthan in males (~1.3% avg)."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "x": 13,
        "y": 139,
        "fontSize": 10,
        "color": "#222222",
        "lineBreak": "\n",
        "lineHeight": 12
      },
      "encoding": {
        "text": {"field": "annotation", "type": "nominal"}
      }
    }
  ]
}