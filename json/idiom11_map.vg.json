{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 240,
  "height": 220,
  "projection": {
    "type": "mercator",
    "center": {"signal": "[lon_offset, lat_offset]"},
    "scale": { "expr": "zoom_level" }
  },
  "params": [
    {
      "name": "section4_year",
      "value": 2022
    },
    {
      "name": "zoom_level",
      "value": 800,
      "bind": {
        "input": "range",
        "min": 500,
        "max": 8000,
        "step": 50,
        "name": "Zoom: "
      }
    },
    {
      "name": "lon_offset",
      "value": 109.5,
      "bind": {
        "input": "range",
        "min": 95,
        "max": 120,
        "step": 0.5,
        "name": "X-Offset (Lon): "
      }
    },
    {
      "name": "lat_offset",
      "value": 4.2,
      "bind": {
        "input": "range",
        "min": -2,
        "max": 10,
        "step": 0.5,
        "name": "Y-Offset (Lat): "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/mptwaktusolat/jakim.geojson/master/malaysia.state.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f0f0",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/section4_idiom11.csv"
      },
      "transform": [
        {"filter": "datum.year == section4_year"},
        {
          "calculate": "datum.state_name == 'W.P. Kuala Lumpur' ? 'WP K Lumpur' : datum.state_name == 'W.P. Putrajaya' ? 'WP Putrajaya' : datum.state_name == 'W.P. Labuan' ? 'WP Labuan' : datum.state_name",
          "as": "clean_state_name"
        },
        {
          "lookup": "clean_state_name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/mptwaktusolat/jakim.geojson/master/malaysia.state.geojson",
              "format": {"type": "json", "property": "features"}
            },
            "key": "properties.name"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "enrolment_rate",
          "type": "quantitative",
          "scale": {
            "domain": [75, 100],
            "scheme": "purples"
          },
          "legend": {
            "title": "Enrolment Rate (%)",
            "gradientLength": 140,
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "state_name", "type": "nominal", "title": "State/Territory"},
          {"field": "enrolment_rate", "type": "quantitative", "title": "Avg Enrolment Rate (%)", "format": ".1f"},
          {"field": "year", "type": "quantitative", "title": "Year"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state_name": "W.P. Kuala Lumpur", "longitude": 101.6869, "latitude": 3.1390},
          {"state_name": "W.P. Putrajaya", "longitude": 101.6964, "latitude": 2.9264},
          {"state_name": "W.P. Labuan", "longitude": 115.2308, "latitude": 5.2831}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "align": "right",
        "dx": -8,
        "dy": 2,
        "color": "#333"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "state_name"}
      }
    }
  ],
  "config": {}
}