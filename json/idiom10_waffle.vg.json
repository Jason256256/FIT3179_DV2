{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 230,
  "height": 140,
  "data": {
    "url": "data/section4_idiom10.csv"
  },
  "params": [
    {
      "name": "section4_year",
      "value": 2022
    }
  ],
  "transform": [
    {"filter": "datum.year == section4_year"},
    {
      "window": [{"op": "row_number", "as": "idx"}],
      "groupby": ["year", "country"]
    },
    {"calculate": "datum.idx - 1", "as": "clean_id"},
    {"calculate": "datum.country == 'Malaysia' ? (datum.clean_id % 10) + 10 : datum.clean_id % 10", "as": "grid_x"},
    {"calculate": "floor(datum.clean_id / 10)", "as": "grid_y"}
  ],
  "mark": {
    "type": "square",
    "size": 115,
    "stroke": "#ffffff",
    "strokeWidth": 0.8
  },
  "encoding": {
    "x": {
      "field": "grid_x",
      "type": "quantitative",
      "scale": {"domain": [-0.5, 19.5]},
      "axis": null,
      "title": null
    },
    "y": {
      "field": "grid_y",
      "type": "quantitative",
      "scale": {"domain": [-0.5, 9.5]},
      "sort": "descending",
      "axis": null,
      "title": null
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": ["AUS_Female", "AUS_Male", "MYS_Female", "MYS_Male"],
        "range": ["#ff00bf", "#00bfff", "#ff0040", "#0040ff"]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,
        "title": "Gender & Country"
      }
    },
    "tooltip": [
      {"field": "country", "type": "nominal", "title": "Country"},
      {"field": "gender", "type": "nominal", "title": "Gender"},
      {"field": "year", "type": "quantitative", "title": "Year"}
    ]
  }
}