{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 240,
  "height": 220,
  "projection": {
    "type": "mercator",
    "center": [133, -27],
    "scale": { "expr": "zoom_level" }
  },
  "params": [
    {
      "name": "section1_year",
      "value": 2022
    },
    {
      "name": "zoom_level",
      "value": 220,
      "bind": {
        "input": "range",
        "min": 150,
        "max": 600,
        "step": 10,
        "name": "Zoom: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/gh/rowanhogan/australian-states@master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f0f0",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/section1_idiom3.csv"
      },
      "transform": [
        {"filter": "datum.year == section1_year"},
        {
          "aggregate": [
            {"op": "mean", "field": "enrolment_rate", "as": "avg_enrolment_rate"}
          ],
          "groupby": ["state_name", "year"]
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "https://cdn.jsdelivr.net/gh/rowanhogan/australian-states@master/states.geojson",
              "format": {"type": "json", "property": "features"}
            },
            "key": "properties.STATE_NAME"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "avg_enrolment_rate",
          "type": "quantitative",
          "scale": {
            "domain": [75, 100],
            "scheme": "tealblues"
          },
          "legend": {
            "title": "Enrolment Rate (%)", 
            "gradientLength": 150,
            "orient": "bottom",
            "direction": "horizontal"
          },
          "title": "Enrolment Rate (%)"
        },
        "tooltip": [
          {"field": "state_name", "type": "nominal", "title": "State/Territory"},
          {"field": "avg_enrolment_rate", "type": "quantitative", "title": "Avg Enrolment Rate (%)", "format": ".1f"},
          {"field": "year", "type": "quantitative", "title": "Year"}
        ]
      }
    }
  ],
  "config": {}
}