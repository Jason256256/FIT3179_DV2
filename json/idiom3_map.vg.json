{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 230,
  "height": 220,
  "projection": {
    "type": "mercator",
    "center": {"signal": "[lon_offset, lat_offset]"},
    "scale": { "expr": "zoom_level" }
  },
  "params": [
    {
      "name": "section1_year",
      "value": 2022
    },
    {
      "name": "zoom_level",
      "value": 220,
      "bind": {
        "input": "range",
        "min": 100,
        "max": 2000,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "lon_offset",
      "value": 133,
      "bind": {
        "input": "range",
        "min": 110,
        "max": 155,
        "step": 1,
        "name": "X-Offset (Lon): "
      }
    },
    {
      "name": "lat_offset",
      "value": -27,
      "bind": {
        "input": "range",
        "min": -45,
        "max": -10,
        "step": 1,
        "name": "Y-Offset (Lat): "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/gh/rowanhogan/australian-states@master/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f0f0",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/section1_idiom3.csv"
      },
      "transform": [
        {"filter": "datum.year == section1_year"},
        {
          "aggregate": [
            {"op": "mean", "field": "enrolment_rate", "as": "avg_enrolment_rate"}
          ],
          "groupby": ["state_name", "year"]
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "https://cdn.jsdelivr.net/gh/rowanhogan/australian-states@master/states.geojson",
              "format": {"type": "json", "property": "features"}
            },
            "key": "properties.STATE_NAME"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "avg_enrolment_rate",
          "type": "quantitative",
          "scale": {
            "domain": [70, 100],
            "scheme": ["#00FFFF", "#00BFFF", "#000040"]
          },
          "legend": {
            "title": "Enrolment Rate (%)", 
            "gradientLength": 200,
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "state_name", "type": "nominal", "title": "State/Territory"},
          {"field": "avg_enrolment_rate", "type": "quantitative", "title": "Avg Enrolment Rate (%)", "format": ".1f"},
          {"field": "year", "type": "quantitative", "title": "Year"}
        ]
      }
    },
    {
      "data": {
        "values": [{"state_name": "Australian Capital Territory", "longitude": 149.13, "latitude": -35.28}]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "align": "left",
        "dx": 12,
        "dy": 2,
        "color": "#333"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"value": "ACT"}
      }
    }
  ],
  "config": {}
}