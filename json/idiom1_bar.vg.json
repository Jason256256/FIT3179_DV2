{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 240,
  "height": 220,
  "data": {
    "url": "data/section1_enrolment.csv"
  },
  "params": [
    {
      "name": "section1_year",
      "value": 2022
    }
  ],
  "transform": [
    {"filter": "datum.community != 'All'"},
    {"filter": "datum.year == section1_year"}
  ],
  "mark": {"type": "bar", "color": "#4080ff"},
  "encoding": {
    "x": {
      "field": "community",
      "type": "nominal",
      "axis": {"labelAngle": -25},
      "title": "Community"
    },
    "y": {
      "field": "enrolment_rate",
      "type": "quantitative",
      "scale": {"domain": [0, 100]},
      "title": "Enrolment Rate (%)"
    },
    "tooltip": [
      {"field": "community", "type": "nominal", "title": "Community"},
      {"field": "enrolment_rate", "type": "quantitative", "title": "Enrolment Rate (%)"}
    ]
  }
}